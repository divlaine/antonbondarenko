---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {projects} from '@/data/content';
import {localize} from '@/i18n/routing';
export function getStaticPaths(){
  return projects.en.map((project)=>({params:{slug:project.slug},props:{project}}));
}
const {project}=Astro.props;
const crumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Projects',item:new URL(localize('/projects','en'),Astro.site)},{'@type':'ListItem',position:2,name:project.title}]};
---
<BaseLayout lang="en" path={`/projects/${project.slug}`} title={`${project.title} — Anton Bondarenko`} description={project.description} schema={crumb}><article class="case shell"><a class="back" href={localize('/projects','en')}>← All projects</a><p class="eyebrow">{project.company} / Engineering case</p><h1>{project.title}</h1><p class="lede">{project.description}</p><dl><div><dt>Role</dt><dd>{project.role}</dd></div>{project.period&&<div><dt>Period</dt><dd>{project.period}</dd></div>}<div><dt>Impact</dt><dd>{project.impact}</dd></div></dl><div class="case-body"><h2>Engineering narrative</h2>{project.narrative.map((x:string)=><p>{x}</p>)}<h2>Technology context</h2><ul class="tags">{project.technologies.map((x:string)=><li>{x}</li>)}</ul>{project.nda&&<p class="inline-note">Some implementation details are NDA-restricted and can be discussed during interviews.</p>}</div></article></BaseLayout>

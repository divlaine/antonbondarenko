---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {projects} from '@/data/content';
import {localize} from '@/i18n/routing';
export function getStaticPaths(){
  return projects.ru.map((project)=>({params:{slug:project.slug},props:{project}}));
}
const {project}=Astro.props;
const crumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Проекты',item:new URL(localize('/projects','ru'),Astro.site)},{'@type':'ListItem',position:2,name:project.title}]};
---
<BaseLayout lang="ru" path={`/projects/${project.slug}`} title={`${project.title} — Антон Бондаренко`} description={project.description} schema={crumb}><article class="case shell"><a class="back" href={localize('/projects','ru')}>← Все проекты</a><p class="eyebrow">{project.company} / Инженерный кейс</p><h1>{project.title}</h1><p class="lede">{project.description}</p><dl><div><dt>Роль</dt><dd>{project.role}</dd></div>{project.period&&<div><dt>Период</dt><dd>{project.period}</dd></div>}<div><dt>Результат</dt><dd>{project.impact}</dd></div></dl><div class="case-body">{project.sections.map((section:{title:string;body:string})=><section class="case-section"><h2>{section.title}</h2><p>{section.body}</p></section>)}<section class="case-section"><h2>Технологии</h2><ul class="tags">{project.technologies.map((x:string)=><li>{x}</li>)}</ul></section>{project.nda&&<p class="inline-note">Часть деталей реализации ограничена NDA и может быть обсуждена на интервью.</p>}</div></article></BaseLayout>

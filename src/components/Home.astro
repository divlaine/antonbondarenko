---
import BaseLayout from '@/layouts/BaseLayout.astro'; import ProjectGrid from './ProjectGrid.astro'; import { profile } from '@/config/profile'; import { copy,type Lang } from '@/i18n/content'; import { impacts,expertise,strengths } from '@/data/content'; import { localize } from '@/i18n/routing';
const {lang}=Astro.props as {lang:Lang}; const t=copy[lang]; const name=lang==='ru'?profile.nameRu:profile.name;
---
<BaseLayout lang={lang} path="/">
<section class="hero shell"><p class="eyebrow">{t.availability}</p><h1>{name}<br/><span>{t.role}</span></h1><p class="hero-copy">{t.intro}</p><div class="cta"><a href={localize('/resume',lang)}>{t.nav.resume}</a><a href={localize('/projects',lang)}>{t.nav.projects}</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={`mailto:${profile.email}`}>Email</a></div></section>
<section class="section shell"><div class="section-head"><div><p class="eyebrow">01 / Outcomes</p><h2>{t.impact}</h2></div><p>{t.impactIntro}</p></div><div class="metrics">{impacts[lang].map(([value,label])=><article><strong>{value}</strong><p>{label}</p></article>)}</div></section>
<section class="section shell"><div class="section-head"><div><p class="eyebrow">02 / Practice</p><h2>{t.bring}</h2></div></div><div class="strengths">{strengths[lang].map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section class="section shell"><div class="section-head"><div><p class="eyebrow">03 / Work</p><h2>{t.featured}</h2></div><a class="text-link" href={localize('/projects',lang)}>{t.viewAll} →</a></div><ProjectGrid lang={lang} featured /></section>
<section class="section shell"><div class="section-head"><div><p class="eyebrow">04 / Stack</p><h2>{t.focus}</h2></div></div><div class="expertise">{expertise[lang].map(({title,key,tools})=><article><h3>{title}</h3><p class="expertise-key">{key}</p><p class="expertise-tools">{tools}</p></article>)}</div></section>
<aside class="nda shell"><span>NDA</span><p>{t.nda}</p></aside>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';import PageIntro from './PageIntro.astro';import {copy,type Lang} from '@/i18n/content';import {profile} from '@/config/profile';import {experience,expertise} from '@/data/content';
const {lang}=Astro.props as {lang:Lang};const t=copy[lang]; const ru=lang==='ru';
---
<BaseLayout lang={lang} path="/resume" title={`${t.resumeTitle} — ${ru?profile.nameRu:profile.name}`} description={ru?'Резюме Антона Бондаренко, Senior iOS-разработчика.':'Résumé of Anton Bondarenko, Senior iOS Developer.'}><PageIntro eyebrow="CV / HTML + PDF" title={t.resumeTitle} description={ru?'Индексируемая HTML-версия актуального резюме.':'Indexable HTML version of the current résumé.'}/><div class="shell resume-actions"><a class="button" href={ru?profile.resumeRu:profile.resumeEn} download>{t.download} ↓</a></div><article class="shell resume"><header><h2>{ru?profile.nameRu:profile.name}</h2><p class="role">{ru?profile.jobTitleRu:profile.jobTitle}</p><p>{ru?profile.locationRu:profile.location} · {ru?profile.availabilityRu:profile.availability}</p></header><section><h2>{ru?'Профессиональный профиль':'Summary'}</h2><p>{ru?'Senior iOS-разработчик с 12-летним опытом коммерческой мобильной разработки, из них 7 лет — в iOS-разработке. Специализируюсь на разработке и архитектуре iOS-приложений, оптимизации производительности, многопоточности и сложных пользовательских интерфейсах. Профилирую и оптимизирую UI, память, скроллинг, аллокации, пайплайны обработки данных и нагрузку на Main Thread с использованием Instruments.':'Senior iOS Developer with 12 years of commercial mobile development experience, including 7 years specializing in iOS. Experienced in application development and architecture, performance optimization, concurrency, and complex user interfaces. Profiles and optimizes UI performance, memory, scrolling, allocations, data pipelines, and Main Thread workload using Instruments.'}</p></section><section><h2>{ru?'Опыт работы':'Experience'}</h2>{experience[lang].map(j=><div class="resume-job"><p class="meta">{j.period}</p><h3>{j.company} · {j.role}</h3><p>{j.context}</p><ul>{j.points.map(x=><li>{x}</li>)}</ul></div>)}</section><section><h2>{ru?'Технические навыки':'Technical skills'}</h2>{expertise[lang].map(([a,b])=><p><b>{a}:</b> {b}</p>)}</section><section><h2>{ru?'Высшее образование':'Education'}</h2><div class="education"><p><b>2013</b><br/>{ru?'Одесская национальная академия пищевых технологий':'Odesa National Academy of Food Technologies'}<br/>{ru?'Кандидат технических наук (PhD)':'PhD in Engineering'}</p><p><b>2010</b><br/>{ru?'Одесская государственная академия холода':'Odesa State Academy of Refrigeration'}<br/>{ru?'Магистр компьютерных систем и сетей':"Master’s degree in Computer Systems and Networks"}</p></div></section><section><h2>{ru?'Языки':'Languages'}</h2><p>{ru?'Русский — родной · Украинский — родной · Английский — B1':'Russian — Native · Ukrainian — Native · English — B1'}</p></section></article></BaseLayout>
